{
  "name": "raccoon-mobile",
  "version": "4.0.0",
  "description": "商汤小浣熊移动端客户端（手机号登录 + 多模型 + 深度思考）",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node test/smoke.js && node test/direct-crypto.js",
    "build:web": "echo 前端为静态资源，无需构建",
    "cap:sync": "npx cap copy android",
    "apk": "cd android && ./gradlew assembleDebug --no-daemon"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  }
}
